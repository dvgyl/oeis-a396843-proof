namespace Families.CatalanComposition

open PowerSeries Hanna.Series Hanna.Related.ScaledInverse

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

def catalan : PowerSeries R := scaledSolution 0

theorem catalan_normalized : Normalized (catalan : PowerSeries R) :=
  scaledSolution_normalized 0

theorem catalan_quadratic : (catalan : PowerSeries R)-catalan^2=X :=
  scaledSolution_zero_quadratic

def N : PowerSeries R := X-X^2

theorem N_normalized : Normalized (N : PowerSeries R) := by
  apply (normalized_iff_X_sq_dvd _).mpr
  change (X : PowerSeries R)^2 ∣ X-X^2-X
  convert dvd_neg.mpr (dvd_refl ((X : PowerSeries R)^2)) using 1
  ring

theorem N_catalan : compose (N : PowerSeries R) catalan=X := by
  rw [N,compose_sub _ _ _ catalan_normalized.constantCoeff,
    compose_pow _ _ _ catalan_normalized.constantCoeff,
    compose_X_left _ catalan_normalized.constantCoeff]
  exact catalan_quadratic

theorem catalan_N : compose (catalan : PowerSeries R) N=X :=
  left_inverse_of_right_inverse catalan_normalized N_catalan

theorem map_catalan (f : R →+* S) :
    PowerSeries.map f (catalan : PowerSeries R)=(catalan : PowerSeries S) := by
  simpa only [catalan,map_zero] using map_scaledSolution f (0 : R)

/-- The canonical A393172 series. -/
def A : PowerSeries R :=
  SquareComposition.solution catalan catalan catalan_normalized catalan_normalized

theorem A_normalized : Normalized (A : PowerSeries R) :=
  SquareComposition.solution_normalized _ _ _ _

theorem A_fixed : (A : PowerSeries R)=catalan+(compose A catalan)^2 :=
  SquareComposition.solution_equation _ _ _ _

theorem source_iff_fixed (G : PowerSeries R) :
    compose G N=X+G^2 ↔ G=catalan+(compose G catalan)^2 := by
  constructor
  · intro he
    have hc := congrArg (fun H => compose H catalan) he
    dsimp only at hc
    rw [compose_assoc _ _ _ N_normalized.constantCoeff catalan_normalized.constantCoeff,
      N_catalan,compose_X_right,compose_add _ _ _ catalan_normalized.constantCoeff,
      compose_X_left _ catalan_normalized.constantCoeff,
      compose_pow _ _ _ catalan_normalized.constantCoeff] at hc
    exact hc
  · intro he
    have hc := congrArg (fun H => compose H N) he
    dsimp only at hc
    rw [compose_add _ _ _ N_normalized.constantCoeff,
      compose_pow _ _ _ N_normalized.constantCoeff,
      compose_assoc _ _ _ catalan_normalized.constantCoeff N_normalized.constantCoeff,
      catalan_N,compose_X_right] at hc
    exact hc

theorem A_equation : compose (A : PowerSeries R) (X-X^2)=X+A^2 :=
  (source_iff_fixed A).mpr A_fixed

theorem A_unique {G : PowerSeries R} (hG : Normalized G)
    (he : compose G (X-X^2)=X+G^2) : G=A :=
  SquareComposition.solution_unique catalan catalan catalan_normalized hG A_normalized
    ((source_iff_fixed G).mp he) A_fixed

theorem a393172_existence_uniqueness :
    ∃! G : PowerSeries R, Normalized G ∧ compose G (X-X^2)=X+G^2 :=
  ⟨A,⟨A_normalized,A_equation⟩,fun _G hG => A_unique hG.1 hG.2⟩

theorem map_A (f : R →+* S) :
    PowerSeries.map f (A : PowerSeries R)=(A : PowerSeries S) := by
  apply A_unique (A_normalized.map f)
  have he := congrArg (PowerSeries.map f) (A_equation (R:=R))
  have hn : constantCoeff R ((X : PowerSeries R)-X^2)=0 :=
    N_normalized.constantCoeff
  simpa only [map_compose f _ _ hn,map_add,map_sub,map_pow,PowerSeries.map_X] using he

/-- The canonical A393171 series, identified below with its literal source. -/
def B : PowerSeries R := X+A^2

theorem B_normalized : Normalized (B : PowerSeries R) := by
  apply (normalized_iff_X_sq_dvd _).mpr
  simpa [B] using pow_dvd_pow_of_dvd (A_normalized (R:=R)).X_dvd 2

theorem B_equation : compose (B : PowerSeries R) (X-X^2)=X-X^2+B^2 := by
  have hn := (N_normalized (R:=R)).constantCoeff
  change compose (B : PowerSeries R) N=N+B^2
  rw [B,compose_add _ _ _ hn,compose_X_left _ hn,compose_pow _ _ _ hn]
  exact congrArg (fun U : PowerSeries R => N+U^2) A_equation

theorem B_composed_catalan : compose (B : PowerSeries R) catalan=A := by
  rw [B,compose_add _ _ _ catalan_normalized.constantCoeff,
    compose_X_left _ catalan_normalized.constantCoeff,
    compose_pow _ _ _ catalan_normalized.constantCoeff]
  exact A_fixed.symm

theorem B_fixed : (B : PowerSeries R)=X+(compose B catalan)^2 := by
  rw [B_composed_catalan]
  rfl

theorem B_source_iff_fixed (G : PowerSeries R) :
    compose G N=N+G^2 ↔ G=X+(compose G catalan)^2 := by
  constructor
  · intro he
    have hc := congrArg (fun H => compose H catalan) he
    dsimp only at hc
    rw [compose_assoc _ _ _ N_normalized.constantCoeff catalan_normalized.constantCoeff,
      N_catalan,compose_X_right,compose_add _ _ _ catalan_normalized.constantCoeff,
      N_catalan,compose_pow _ _ _ catalan_normalized.constantCoeff] at hc
    exact hc
  · intro he
    have hc := congrArg (fun H => compose H N) he
    dsimp only at hc
    rw [compose_add _ _ _ N_normalized.constantCoeff,
      compose_X_left _ N_normalized.constantCoeff,
      compose_pow _ _ _ N_normalized.constantCoeff,
      compose_assoc _ _ _ catalan_normalized.constantCoeff N_normalized.constantCoeff,
      catalan_N,compose_X_right] at hc
    exact hc

theorem B_unique {G : PowerSeries R} (hG : Normalized G)
    (he : compose G (X-X^2)=X-X^2+G^2) : G=B :=
  SquareComposition.solution_unique catalan X catalan_normalized hG B_normalized
    ((B_source_iff_fixed G).mp he) B_fixed

theorem a393171_existence_uniqueness :
    ∃! G : PowerSeries R, Normalized G ∧ compose G (X-X^2)=X-X^2+G^2 :=
  ⟨B,⟨B_normalized,B_equation⟩,fun _G hG => B_unique hG.1 hG.2⟩

theorem a393171_named_existence_uniqueness :
    ∃! G : PowerSeries R, Normalized G ∧ G=X+(compose G catalan)^2 :=
  ⟨B,⟨B_normalized,B_fixed⟩,fun G hG =>
    B_unique hG.1 ((B_source_iff_fixed G).mpr hG.2)⟩

theorem map_B (f : R →+* S) :
    PowerSeries.map f (B : PowerSeries R)=(B : PowerSeries S) := by
  simp only [B,map_add,map_pow,PowerSeries.map_X,map_A]

private theorem compose_double (U V : PowerSeries R) (hV : constantCoeff R V=0) :
    compose (2*U) V=2*compose U V := by
  rw [two_mul,compose_add _ _ _ hV,two_mul]

theorem A_mod_four : (A : PowerSeries (ZMod 4))=2*catalan-X := by
  apply (A_unique (G:=2*catalan-X) ?_ ?_).symm
  · constructor
    · simp [two_mul,catalan_normalized.constantCoeff]
    · simp [two_mul,catalan_normalized.2]
  · have hn := (N_normalized (R:=ZMod 4)).constantCoeff
    change compose (2*catalan-X) N=X+(2*catalan-X)^2
    rw [compose_sub _ _ _ hn,compose_double _ _ hn,catalan_N,compose_X_left _ hn,N]
    have h4 : (4 : PowerSeries (ZMod 4))=0 := by
      simpa only [map_ofNat,map_zero] using congrArg (C (ZMod 4)) (by decide : (4 : ZMod 4)=0)
    linear_combination (X*catalan-catalan^2)*h4

def a (n : ℕ) : ℤ := coeff ℤ n A
def b (n : ℕ) : ℤ := coeff ℤ n B

private theorem double_residue (u : ZMod 4) :
    (2*u=2 ↔ Families.ModFour.reduce u=1) ∧
    (2*u=0 ↔ Families.ModFour.reduce u≠1) := by
  exact (by decide : ∀ u : ZMod 4,
    (2*u=2 ↔ Families.ModFour.reduce u=1) ∧
    (2*u=0 ↔ Families.ModFour.reduce u≠1)) u

theorem a393172_residue (n : ℕ) (hn : 1<n) :
    ((a n : ZMod 4)=2 ↔ ∃ k : ℕ, n=2^k) ∧
    ((a n : ZMod 4)=0 ↔ ¬∃ k : ℕ, n=2^k) := by
  have hm := congrArg (coeff (ZMod 4) n) (map_A (Int.castRingHom (ZMod 4)))
  rw [coeff_map,A_mod_four,map_sub,two_mul,map_add,coeff_X,
    if_neg (by omega : n≠1),sub_zero,← two_mul] at hm
  change (a n : ZMod 4)=2*coeff (ZMod 4) n catalan at hm
  rw [hm]
  have hr := congrArg (coeff (ZMod 2) n) (map_catalan Families.ModFour.reduce)
  rw [coeff_map] at hr
  have hs := scaledSolution_zero_coeff_one_iff n
  change coeff (ZMod 2) n catalan=1 ↔ ∃ k : ℕ, n=2^k at hs
  have hd := double_residue (coeff (ZMod 4) n catalan)
  rw [hr] at hd
  exact ⟨hd.1.trans hs,hd.2.trans (not_congr hs)⟩

theorem a393172_four_dvd_iff (n : ℕ) (hn : 1<n) :
    (4 : ℤ) ∣ a n ↔ ¬∃ k : ℕ, n=2^k := by
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd (a n) 4).symm.trans (a393172_residue n hn).2

/-- Exact division by four is justified by the preceding full-series congruence. -/
def remainderQuarter : PowerSeries ℤ :=
  PowerSeries.mk (fun n => coeff ℤ n (A-(2*catalan-X))/4)

theorem A_integer_decomposition :
    (A : PowerSeries ℤ)=2*catalan-X+4*remainderQuarter := by
  have hm : PowerSeries.map (Int.castRingHom (ZMod 4))
      ((A : PowerSeries ℤ)-(2*catalan-X))=0 := by
    simp only [map_sub,map_mul,map_ofNat,PowerSeries.map_X,map_A,map_catalan,A_mod_four,
      sub_self]
  have hfour : (4 : PowerSeries ℤ)*remainderQuarter=A-(2*catalan-X) := by
    ext n
    have hc := congrArg (coeff (ZMod 4) n) hm
    simp only [coeff_map,Int.coe_castRingHom,map_zero] at hc
    have hd := (ZMod.intCast_zmod_eq_zero_iff_dvd
      (coeff ℤ n (A-(2*catalan-X))) 4).mp hc
    have hmul : (4 : PowerSeries ℤ)*remainderQuarter=
        remainderQuarter+remainderQuarter+remainderQuarter+remainderQuarter := by ring
    rw [hmul]
    simp only [map_add,remainderQuarter,coeff_mk]
    obtain ⟨k,hk⟩ := hd
    omega
  linear_combination -hfour

/-- A complete series reduction, stronger than the indexed A393171 assertion. -/
theorem B_mod_eight : (B : PowerSeries (ZMod 8))=
    X+X^2+4*(catalan-X-X*catalan) := by
  have hm := congrArg (PowerSeries.map (Int.castRingHom (ZMod 8))) A_integer_decomposition
  simp only [map_add,map_sub,map_mul,map_ofNat,PowerSeries.map_X,map_A,map_catalan] at hm
  let K : PowerSeries (ZMod 8) := PowerSeries.map (Int.castRingHom (ZMod 8)) remainderQuarter
  have h8 : (8 : PowerSeries (ZMod 8))=0 := by
    simpa only [map_ofNat,map_zero] using congrArg (C (ZMod 8)) (by decide : (8 : ZMod 8)=0)
  calc
    B=X+(2*catalan-X)^2+8*((2*catalan-X)*K+2*K^2) := by
      rw [B,hm]
      dsimp only [K]
      ring
    _=X+X^2+4*(catalan-X-X*catalan) := by
      rw [h8,zero_mul,add_zero]
      linear_combination -4*(catalan_quadratic (R:=ZMod 8))

def reduceEightTwo : ZMod 8 →+* ZMod 2 := ZMod.castHom (by decide : 2∣8) (ZMod 2)

private theorem quadruple_residue (u : ZMod 8) :
    (4*u=4 ↔ reduceEightTwo u=1) ∧
    (4*u=0 ↔ reduceEightTwo u≠1) := by
  exact (by decide : ∀ u : ZMod 8,
    (4*u=4 ↔ reduceEightTwo u=1) ∧
    (4*u=0 ↔ reduceEightTwo u≠1)) u

private theorem no_adjacent_powers (n : ℕ) (hn : 2<n) :
    ¬((∃ k : ℕ, n=2^k) ∧ (∃ k : ℕ, n-1=2^k)) := by
  rintro ⟨⟨k,hk⟩,⟨l,hl⟩⟩
  cases k with
  | zero => simp only [pow_zero] at hk; omega
  | succ k =>
    cases l with
    | zero => simp only [pow_zero] at hl; omega
    | succ l =>
      rw [pow_succ] at hk hl
      omega

private theorem power_or_next (n : ℕ) (hn : 2<n) :
    ((∃ k : ℕ, n=2^k) ∨ (∃ k : ℕ, n-1=2^k)) ↔
      ∃ k : ℕ, 1≤k ∧ (n=2^k ∨ n=2^k+1) := by
  constructor
  · rintro (⟨k,hk⟩ | ⟨k,hk⟩)
    · refine ⟨k,?_,Or.inl hk⟩
      cases k with
      | zero => simp only [pow_zero] at hk; omega
      | succ k => omega
    · refine ⟨k,?_,Or.inr (by omega)⟩
      cases k with
      | zero => simp only [pow_zero] at hk; omega
      | succ k => omega
  · rintro ⟨k,_,hk | hk⟩
    · exact Or.inl ⟨k,hk⟩
    · exact Or.inr ⟨k,by omega⟩

theorem catalan_adjacent_parity (n : ℕ) (hn : 2<n) :
    coeff (ZMod 2) n catalan-coeff (ZMod 2) (n-1) catalan=1 ↔
      ∃ k : ℕ, 1≤k ∧ (n=2^k ∨ n=2^k+1) := by
  have hf : ∀ u v : ZMod 2, (u-v=1 ↔ ((u=1 ∨ v=1) ∧ ¬(u=1 ∧ v=1))) := by decide
  change coeff (ZMod 2) n (scaledSolution 0)-coeff (ZMod 2) (n-1) (scaledSolution 0)=1 ↔ _
  rw [hf,scaledSolution_zero_coeff_one_iff,scaledSolution_zero_coeff_one_iff,
    and_iff_left (no_adjacent_powers n hn)]
  exact power_or_next n hn

theorem a393171_residue (n : ℕ) (hn : 2<n) :
    ((b n : ZMod 8)=4 ↔ ∃ k : ℕ, 1≤k ∧ (n=2^k ∨ n=2^k+1)) ∧
    ((b n : ZMod 8)=0 ↔ ¬∃ k : ℕ, 1≤k ∧ (n=2^k ∨ n=2^k+1)) := by
  have hm := congrArg (coeff (ZMod 8) n) (map_B (Int.castRingHom (ZMod 8)))
  rw [coeff_map,B_mod_eight] at hm
  have hfour (U : PowerSeries (ZMod 8)) :
      coeff (ZMod 8) n (4*U)=4*coeff (ZMod 8) n U := by
    have he : (4 : PowerSeries (ZMod 8))*U=U+U+U+U := by ring
    rw [he]
    simp only [map_add]
    ring
  have hx : coeff (ZMod 8) n (X*catalan)=coeff (ZMod 8) (n-1) catalan := by
    have he : n=n-1+1 := by omega
    conv_lhs => lhs; arg 2; rw [he]
    exact coeff_succ_X_mul _ _
  simp only [map_add,map_sub,hfour,coeff_X,coeff_X_pow,
    if_neg (by omega : n≠1),if_neg (by omega : n≠2),zero_add,sub_zero,hx] at hm
  change (b n : ZMod 8)=4*(coeff (ZMod 8) n catalan-coeff (ZMod 8) (n-1) catalan) at hm
  rw [hm]
  have hr (m : ℕ) := congrArg (coeff (ZMod 2) m) (map_catalan reduceEightTwo)
  simp only [coeff_map] at hr
  have hd := quadruple_residue
    (coeff (ZMod 8) n catalan-coeff (ZMod 8) (n-1) catalan)
  rw [map_sub,hr n,hr (n-1)] at hd
  have hs := catalan_adjacent_parity n hn
  exact ⟨hd.1.trans hs,hd.2.trans (not_congr hs)⟩

theorem a393171_eight_dvd_iff (n : ℕ) (hn : 2<n) :
    (8 : ℤ) ∣ b n ↔ ¬∃ k : ℕ, 1≤k ∧ (n=2^k ∨ n=2^k+1) := by
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd (b n) 8).symm.trans (a393171_residue n hn).2

