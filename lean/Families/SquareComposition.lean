import Hanna.Related.ScaledParity

/-!
# A contracting family of square-composition equations

For normalized `P,T`, the equation `G = T + (G ∘ P)^2` has a unique
normalized formal series over every commutative ring.  The construction
uses a triangular coefficient recursion, without an existence assumption.

AI-generated by OpenAI ChatGPT for Dev D. Goyal.
-/

namespace Families.SquareComposition

open PowerSeries Hanna.Series

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

def step (P T G : PowerSeries R) : PowerSeries R := T + (compose G P)^2

theorem step_normalized (P T G : PowerSeries R)
    (hP : Normalized P) (hT : Normalized T) (hG : Normalized G) :
    Normalized (step P T G) := by
  apply (normalized_iff_X_sq_dvd _).mpr
  have hc := hG.compose hP
  have hs : (X : PowerSeries R)^2 ∣ (compose G P)^2 :=
    pow_dvd_pow_of_dvd hc.X_dvd 2
  convert dvd_add ((normalized_iff_X_sq_dvd _).mp hT) hs using 1
  unfold step
  ring

theorem step_contraction (P T G H : PowerSeries R) (n : ℕ)
    (hP : Normalized P) (hG : Normalized G) (hH : Normalized H)
    (hGH : (X : PowerSeries R)^n ∣ G-H) :
    (X : PowerSeries R)^(n+1) ∣ step P T G-step P T H := by
  have hd : (X : PowerSeries R)^n ∣ compose G P-compose H P := by
    rw [← compose_sub _ _ _ hP.constantCoeff]
    have hx : (X : PowerSeries R)^1 ∣ P := by simpa using hP.X_dvd
    simpa using compose_outer_vanish (G-H) P n 1 hP.constantCoeff hGH hx
  have hs : (X : PowerSeries R)^1 ∣ compose G P+compose H P := by
    simpa using dvd_add (hG.compose hP).X_dvd (hH.compose hP).X_dvd
  convert X_pow_dvd_product hd hs using 1
  unfold step
  ring

theorem equation_triangular (P T : PowerSeries R) (hP : Normalized P) :
    Triangular (fun a n => coeff R (n+2) (ofTail a-step P T (ofTail a))) := by
  intro n a b hab
  have hd := (agree_iff_X_pow_dvd_sub (n+2) (ofTail a) (ofTail b)).mp
    (ofTail_agree a b n hab)
  have hp := step_contraction P T (ofTail a) (ofTail b) (n+2) hP
    (normalized_ofTail a) (normalized_ofTail b) hd
  have hc := X_pow_dvd_iff.mp hp (n+2) (by omega)
  simp only [map_sub, coeff_ofTail] at hc ⊢
  linear_combination -hc

theorem solution_exists (P T : PowerSeries R) (hP : Normalized P)
    (hT : Normalized T) : ∃ G : PowerSeries R, Normalized G ∧ G=step P T G := by
  let op := fun a n => coeff R (n+2) (ofTail a-step P T (ofTail a))
  let a := triangularCoeffs op (fun _ => 0)
  have ha := triangularCoeffs_spec op (equation_triangular P T hP) (fun _ => 0)
  refine ⟨ofTail a,normalized_ofTail a,?_⟩
  have hs := step_normalized P T (ofTail a) hP hT (normalized_ofTail a)
  ext n
  rcases n with _ | (_ | n)
  · exact (normalized_ofTail a).1.trans hs.1.symm
  · exact (normalized_ofTail a).2.trans hs.2.symm
  · have hc := congrFun ha n
    change coeff R (n+2) (ofTail a-step P T (ofTail a))=0 at hc
    simpa only [map_sub,sub_eq_zero,Nat.succ_eq_add_one,Nat.add_assoc] using hc

theorem solution_unique (P T : PowerSeries R) (hP : Normalized P)
    {G H : PowerSeries R} (hG : Normalized G) (hH : Normalized H)
    (heG : G=step P T G) (heH : H=step P T H) : G=H := by
  ext n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    have hd := (agree_iff_X_pow_dvd_sub n G H).mp ih
    have hp := step_contraction P T G H n hP hG hH hd
    have hc := X_pow_dvd_iff.mp hp n (by omega)
    rw [← heG,← heH,map_sub,sub_eq_zero] at hc
    exact hc

theorem existence_uniqueness (P T : PowerSeries R) (hP : Normalized P)
    (hT : Normalized T) :
    ∃! G : PowerSeries R, Normalized G ∧ G=T+(compose G P)^2 := by
  obtain ⟨G,hG,heG⟩ := solution_exists P T hP hT
  exact ⟨G,⟨hG,heG⟩,fun H hH => solution_unique P T hP hH.1 hG hH.2 heG⟩

def solution (P T : PowerSeries R) (hP : Normalized P) (hT : Normalized T) :
    PowerSeries R := (existence_uniqueness P T hP hT).exists.choose

theorem solution_normalized (P T : PowerSeries R) (hP : Normalized P)
    (hT : Normalized T) : Normalized (solution P T hP hT) :=
  (existence_uniqueness P T hP hT).exists.choose_spec.1

theorem solution_equation (P T : PowerSeries R) (hP : Normalized P)
    (hT : Normalized T) :
    solution P T hP hT=T+(compose (solution P T hP hT) P)^2 :=
  (existence_uniqueness P T hP hT).exists.choose_spec.2

theorem map_solution (f : R →+* S) (P T : PowerSeries R)
    (hP : Normalized P) (hT : Normalized T) :
    PowerSeries.map f (solution P T hP hT)=
      solution (PowerSeries.map f P) (PowerSeries.map f T) (hP.map f) (hT.map f) := by
  apply solution_unique _ _ (hP.map f)
    ((solution_normalized P T hP hT).map f) (solution_normalized _ _ _ _)
    _ (solution_equation _ _ _ _)
  have he := congrArg (PowerSeries.map f) (solution_equation P T hP hT)
  simpa only [step,map_add,map_pow,map_compose f _ _ hP.constantCoeff] using he

end
end Families.SquareComposition
