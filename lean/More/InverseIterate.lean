import Consecutive.IntegerIterates

/-!
# OEIS A396102 and an inverse-iterate family

For every natural parameter `r`, construct the unique normalized integral
series `R = X - R * R^[r]`, then take its genuine compositional inverse `F`.
For positive parameters this is exactly the family
`F^[r] = (1+X) * F^[r-1]`.  Parameter three is the defining equation of
A396102.  We prove existence and uniqueness for that original equation and
derive its coefficient congruence from the canonical construction.

AI disclosure: this file and its proofs were generated by OpenAI ChatGPT for
Dev D. Goyal.  Lean checks the proof terms against the stated definitions.
-/

namespace InverseIterate

open PowerSeries Hanna.Series Consecutive

noncomputable section

variable {S T : Type*} [CommRing S] [CommRing T]

def step (r : ℕ) (G : PowerSeries S) : PowerSeries S := X-G*iter G r

theorem step_normalized (r : ℕ) {G : PowerSeries S} (hG : Normalized G) :
    Normalized (step r G) := by
  have hi := iter_normalized hG r
  constructor
  · simp [step, coeff_zero_eq_constantCoeff_apply, hG.constantCoeff, hi.constantCoeff]
  · rw [step, map_sub]
    have hd : (X : PowerSeries S)^2 ∣ G*iter G r := by
      simpa using X_pow_dvd_product
        (show (X : PowerSeries S)^1 ∣ G by simpa using hG.X_dvd)
        (show (X : PowerSeries S)^1 ∣ iter G r by simpa using hi.X_dvd)
    rw [X_pow_dvd_iff.mp hd 1 (by omega)]
    simp

theorem step_contraction (r n : ℕ) {G H : PowerSeries S}
    (hG : Normalized G) (hH : Normalized H)
    (hGH : (X : PowerSeries S)^n ∣ G-H) :
    (X : PowerSeries S)^(n+1) ∣ step r G-step r H := by
  have hi := iter_congr hG hH n r hGH
  have hp1 := X_pow_dvd_product hGH
    (show (X : PowerSeries S)^1 ∣ iter G r by
      simpa using (iter_normalized hG r).X_dvd)
  have hp2 := X_pow_dvd_product hi
    (show (X : PowerSeries S)^1 ∣ H by simpa using hH.X_dvd)
  convert dvd_neg.mpr (dvd_add hp1 hp2) using 1
  simp only [step]
  ring

theorem equation_triangular (r : ℕ) :
    Triangular (fun a n => coeff S (n+2) (ofTail a-step r (ofTail a))) := by
  intro n a b hab
  have hd := (agree_iff_X_pow_dvd_sub (n+2) (ofTail a) (ofTail b)).mp
    (ofTail_agree a b n hab)
  have hp := step_contraction r (n+2) (normalized_ofTail a) (normalized_ofTail b) hd
  have hc := X_pow_dvd_iff.mp hp (n+2) (by omega)
  simp only [map_sub, coeff_ofTail] at hc ⊢
  linear_combination -hc

theorem R_exists (r : ℕ) :
    ∃ G : PowerSeries S, Normalized G ∧ G=step r G := by
  let op := fun a n => coeff S (n+2) (ofTail a-step r (ofTail a))
  let a := triangularCoeffs op (fun _ => 0)
  have ha := triangularCoeffs_spec op (equation_triangular r) (fun _ => 0)
  refine ⟨ofTail a, normalized_ofTail a, ?_⟩
  have hs := step_normalized r (normalized_ofTail a)
  ext n
  rcases n with _ | (_ | n)
  · exact (normalized_ofTail a).1.trans hs.1.symm
  · exact (normalized_ofTail a).2.trans hs.2.symm
  · have hc := congrFun ha n
    change coeff S (n+2) (ofTail a-step r (ofTail a))=0 at hc
    simpa only [map_sub, sub_eq_zero, Nat.succ_eq_add_one, Nat.add_assoc] using hc

theorem R_unique (r : ℕ) {G H : PowerSeries S}
    (hG : Normalized G) (hH : Normalized H)
    (hEG : G=step r G) (hEH : H=step r H) : G=H := by
  ext n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    have hd := (agree_iff_X_pow_dvd_sub n G H).mp ih
    have hp := step_contraction r n hG hH hd
    have hc := X_pow_dvd_iff.mp hp n (by omega)
    rw [← hEG, ← hEH, map_sub, sub_eq_zero] at hc
    exact hc

theorem R_existence_uniqueness (r : ℕ) :
    ∃! G : PowerSeries S, Normalized G ∧ G=step r G := by
  obtain ⟨G,hG,hE⟩ := R_exists (S:=S) r
  exact ⟨G,⟨hG,hE⟩,fun H hH => R_unique r hH.1 hG hH.2 hE⟩

/-- The integral auxiliary series; existence is proved by triangular recursion. -/
def R (r : ℕ) : PowerSeries S := (R_existence_uniqueness (S:=S) r).exists.choose

theorem R_normalized (r : ℕ) : Normalized (R (S:=S) r) :=
  (R_existence_uniqueness (S:=S) r).exists.choose_spec.1

theorem R_equation (r : ℕ) : R (S:=S) r=step r (R r) :=
  (R_existence_uniqueness (S:=S) r).exists.choose_spec.2

/-- The series in the original iterated functional equation. -/
def F (r : ℕ) : PowerSeries S := inverse (R r) (R_normalized r)

theorem F_normalized (r : ℕ) : Normalized (F (S:=S) r) :=
  inverse_normalized (R r) (R_normalized r)

theorem compose_R_F (r : ℕ) : compose (R (S:=S) r) (F r)=X :=
  compose_inverse_right (R r) (R_normalized r)

theorem compose_F_R (r : ℕ) : compose (F (S:=S) r) (R r)=X :=
  compose_inverse_left (R r) (R_normalized r)

theorem compose_iter_inverse_cancel (G : PowerSeries S) (hG : Normalized G)
    (m n : ℕ) :
    compose (iter G m) (iter (inverse G hG) (m+n))=iter (inverse G hG) n := by
  have hi := inverse_normalized G hG
  rw [iter_add hi m n,
    ← compose_assoc _ _ _ (iter_normalized hi m).constantCoeff
      (iter_normalized hi n).constantCoeff,
    iter_inverse_right G hG m, compose_X_left _ (iter_normalized hi n).constantCoeff]

/-- The canonical series satisfies the original consecutive-iterate equation. -/
theorem F_original_equation (r : ℕ) :
    iter (F (S:=S) (r+1)) (r+1)=(1+X)*iter (F (r+1)) r := by
  let G := R (S:=S) (r+1)
  let H := F (S:=S) (r+1)
  have hH : Normalized H := F_normalized (r+1)
  have hc : compose G (iter H (r+1))=iter H r := by
    simpa only [iter_one, Nat.add_comm 1 r, G, H, F] using
      compose_iter_inverse_cancel G (R_normalized (r+1)) 1 r
  have hi : compose (iter G (r+1)) (iter H (r+1))=X :=
    iter_inverse_right G (R_normalized (r+1)) (r+1)
  have h := congrArg (fun E => compose E (iter H (r+1))) (R_equation (S:=S) (r+1))
  change compose G (iter H (r+1)) = compose (X-G*iter G (r+1)) (iter H (r+1)) at h
  rw [compose_sub _ _ _ (iter_normalized hH (r+1)).constantCoeff,
    compose_mul _ _ _ (iter_normalized hH (r+1)).constantCoeff,
    compose_X_left _ (iter_normalized hH (r+1)).constantCoeff, hc, hi] at h
  change iter H (r+1)=(1+X)*iter H r
  linear_combination -h

theorem original_equation_inverse (r : ℕ) (G : PowerSeries S) (hG : Normalized G)
    (he : iter G (r+1)=(1+X)*iter G r) :
    inverse G hG=step (r+1) (inverse G hG) := by
  let H := inverse G hG
  have hH : Normalized H := inverse_normalized G hG
  have hc : compose (iter G r) (iter H (r+1))=H := by
    simpa only [iter_one, H] using compose_iter_inverse_cancel G hG r 1
  have hi : compose (iter G (r+1)) (iter H (r+1))=X :=
    iter_inverse_right G hG (r+1)
  have h := congrArg (fun E => compose E (iter H (r+1))) he
  change compose (iter G (r+1)) (iter H (r+1)) =
    compose ((1+X)*iter G r) (iter H (r+1)) at h
  rw [hi,
    compose_mul _ _ _ (iter_normalized hH (r+1)).constantCoeff,
    compose_add _ _ _ (iter_normalized hH (r+1)).constantCoeff,
    compose_one _ (iter_normalized hH (r+1)).constantCoeff,
    compose_X_left _ (iter_normalized hH (r+1)).constantCoeff, hc] at h
  change H=X-H*iter H (r+1)
  linear_combination -h

/-- Every normalized solution of the source equation is the constructed one. -/
theorem F_original_unique (r : ℕ) (G : PowerSeries S) (hG : Normalized G)
    (he : iter G (r+1)=(1+X)*iter G r) : G=F (r+1) := by
  have hR : inverse G hG=R (r+1) :=
    R_unique (r+1) (inverse_normalized G hG) (R_normalized (r+1))
      (original_equation_inverse r G hG he) (R_equation (r+1))
  apply Hanna.Series.inverse_unique (inverse_normalized G hG) (F_normalized (r+1))
    (compose_inverse_right G hG)
  rw [hR]
  exact compose_R_F (r+1)

theorem F_original_existence_uniqueness (r : ℕ) :
    ∃! G : PowerSeries S, Normalized G ∧ iter G (r+1)=(1+X)*iter G r := by
  exact ⟨F (r+1), ⟨F_normalized (r+1), F_original_equation r⟩,
    fun G hG => F_original_unique r G hG.1 hG.2⟩

theorem map_step (f : S →+* T) (r : ℕ) {G : PowerSeries S} (hG : Normalized G) :
    PowerSeries.map f (step r G)=step r (PowerSeries.map f G) := by
  simp only [step, map_sub, map_mul, PowerSeries.map_X, map_iter f hG]

theorem map_R (f : S →+* T) (r : ℕ) :
    PowerSeries.map f (R (S:=S) r)=R (S:=T) r := by
  apply R_unique r ((R_normalized r).map f) (R_normalized r)
  · rw [← map_step f r (R_normalized r), ← R_equation]
  · exact R_equation r

private theorem inverse_congr {G H : PowerSeries S}
    (hG : Normalized G) (hH : Normalized H) (he : G=H) :
    inverse G hG=inverse H hH := by
  subst H
  rfl

theorem map_F (f : S →+* T) (r : ℕ) :
    PowerSeries.map f (F (S:=S) r)=F (S:=T) r := by
  change PowerSeries.map f (inverse (R (S:=S) r) (R_normalized r)) =
    inverse (R (S:=T) r) (R_normalized r)
  rw [map_inverse]
  exact inverse_congr ((R_normalized r).map f) (R_normalized r) (map_R f r)

theorem mobius_fixedpoint (r : ℕ) (hr : (r : S)=0) :
    step r (mobius (-1 : S))=mobius (-1 : S) := by
  rw [step, iter_mobius, hr, zero_mul, mobius_zero]
  have hg : ((1 : PowerSeries S)+X)*geom (-1 : S)=1 := by
    simpa only [map_neg, map_one, neg_one_mul, sub_neg_eq_add] using geom_inverse (-1 : S)
  change X-(X*geom (-1 : S))*X=X*geom (-1 : S)
  linear_combination -(X : PowerSeries S)*hg

theorem R_mod (r : ℕ) : R (S:=ZMod r) r=mobius (-1) := by
  apply R_unique r (R_normalized r) (mobius_normalized (-1)) (R_equation r)
  exact (mobius_fixedpoint r (ZMod.natCast_self r)).symm

/-- Uniform coefficient reduction for the entire inverse-iterate family. -/
theorem F_mod (r : ℕ) : F (S:=ZMod r) r=mobius 1 := by
  rw [F, inverse_congr (R_normalized r) (mobius_normalized (-1)) (R_mod r),
    inverse_mobius]
  simp

def a (r n : ℕ) : ℤ := coeff ℤ n (F r)

theorem coefficient_congruence (r n : ℕ) (hn : 1≤n) :
    (a r n : ZMod r)=1 := by
  have h := congrArg (coeff (ZMod r) n) (map_F (Int.castRingHom (ZMod r)) r)
  simpa only [PowerSeries.coeff_map, Int.coe_castRingHom, a, F_mod,
    coeff_mobius_of_pos _ n hn, one_pow] using h

/-- A396102 is the canonical parameter-three integer series. -/
def A396102 : PowerSeries ℤ := F 3

theorem a396102_definition :
    compose A396102 (compose A396102 A396102)=
      (1+X)*compose A396102 A396102 := by
  simpa only [A396102, iter_succ, iter_one, iter_zero, compose_X_right] using
    (F_original_equation (S:=ℤ) 2)

theorem a396102_unique (G : PowerSeries ℤ) (hG : Normalized G)
    (he : compose G (compose G G)=(1+X)*compose G G) : G=A396102 := by
  apply F_original_unique 2 G hG
  simpa only [iter_succ, iter_one, iter_zero, compose_X_right] using he

/-- The conjecture in OEIS A396102, for every positive coefficient index. -/
theorem a396102_congruence (n : ℕ) (hn : 1≤n) :
    (coeff ℤ n A396102 : ZMod 3)=1 := coefficient_congruence 3 n hn

/-- Stronger statement: every natural iterate has the expected geometric
coefficient pattern modulo the family parameter. -/
theorem iterate_coefficient_congruence (r k n : ℕ) (hn : 1≤n) :
    (coeff ℤ n (iter (F r) k) : ZMod r)=(k : ZMod r)^(n-1) := by
  have h := congrArg (coeff (ZMod r) n)
    (map_iter (Int.castRingHom (ZMod r)) (F_normalized r) k)
  simpa only [PowerSeries.coeff_map, Int.coe_castRingHom, map_F, F_mod,
    iter_mobius, mul_one, coeff_mobius_of_pos _ n hn] using h

end
end InverseIterate
