import Consecutive.Modular
import Mathlib.Algebra.Ring.Int.Parity
import Mathlib.Tactic.IntervalCases

/-!
# The two parity conjectures for OEIS A396093

The sequence is defined here from its original generating function: the third
compositional iterate of `B = X/(1-X)^2`, over the integers.  Reduction modulo
two yields an exact rational-series identity and the complete period-ten
coefficient pattern.  All indices are quantified; no finite table is used as
an assumption.

AI disclosure: this file and its proofs were generated by OpenAI ChatGPT for
Dev D. Goyal.  Lean checks the proof terms against the stated definitions.
-/

namespace RationalParity

open PowerSeries Hanna.Series Consecutive

noncomputable section

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The original map `X/(1-X)^2`, defined over any commutative ring. -/
def B : PowerSeries R := X * geom (1 : R) ^ 2

theorem B_normalized : Normalized (B : PowerSeries R) := by
  constructor
  · simp [B]
  · simp [B]

/-- A396093 is the third compositional iterate, exactly as in OEIS. -/
def A : PowerSeries R := iter B 3

/-- The integer sequence, including its zero constant coefficient. -/
def a (n : ℕ) : ℤ := coeff ℤ n A

theorem A_definition : (A : PowerSeries R) = compose B (compose B B) := by
  simp [A, iter]

theorem map_geom_one (f : R →+* S) :
    PowerSeries.map f (geom (1 : R)) = geom (1 : S) := by
  ext n
  simp

theorem map_B (f : R →+* S) :
    PowerSeries.map f (B : PowerSeries R) = (B : PowerSeries S) := by
  simp [B, map_geom_one]

theorem map_A (f : R →+* S) :
    PowerSeries.map f (A : PowerSeries R) = (A : PowerSeries S) := by
  rw [A, map_iter f B_normalized, map_B]
  rfl

theorem B_denominator : (B : PowerSeries R) * (1-X)^2 = X := by
  have hg : ((1 : PowerSeries R)-X)*geom (1 : R) = 1 := by
    simpa using geom_inverse (1 : R)
  calc
    B * (1-X)^2 = X * (((1-X)*geom (1 : R))^2) := by dsimp [B]; ring
    _ = X := by rw [hg]; simp

theorem compose_B_denominator (F : PowerSeries R) (hF : constantCoeff R F = 0) :
    compose B F * (1-F)^2 = F := by
  have h := congrArg (fun G : PowerSeries R => compose G F)
    (B_denominator (R:=R))
  simpa only [compose_mul _ _ _ hF, compose_pow _ _ _ hF,
    compose_sub _ _ _ hF, compose_one _ hF, compose_X_left _ hF] using h

private abbrev F := ZMod 2

private theorem two_eq_zero : (2 : PowerSeries F) = 0 := by
  change C F (2 : F) = 0
  rw [show (2 : F) = 0 by decide]
  simp

private theorem neg_eq_self (V : PowerSeries F) : -V = V := by
  ext n
  simp [ZMod.neg_eq_self_mod_two]

private theorem square_one_sub (V : PowerSeries F) : (1-V)^2 = 1+V^2 := by
  linear_combination -V * two_eq_zero

private theorem rational_next {T : Type*} [CommRing T]
    (b t d p : T) (hb : b*d=p) (ht : t*(1+b^2)=b) :
    t*(d^2+p^2)=p*d := by
  calc
    t*(d^2+p^2) = t*(d^2+(b*d)^2) := by rw [hb]
    _ = (t*(1+b^2))*d^2 := by ring
    _ = b*d^2 := by rw [ht]
    _ = (b*d)*d := by ring
    _ = p*d := by rw [hb]

/-- Exact characteristic-two denominator for the second iterate. -/
theorem second_denominator :
    iter (B : PowerSeries F) 2 * (1+X^2+X^4) = X+X^3 := by
  have hb : (B : PowerSeries F)*(1+X^2)=X := by
    simpa only [square_one_sub] using (B_denominator (R:=F))
  have ht : iter (B : PowerSeries F) 2*(1+B^2)=B := by
    rw [iter_succ (B : PowerSeries F) 1, iter_one]
    simpa only [square_one_sub] using
      compose_B_denominator (B : PowerSeries F) B_normalized.constantCoeff
  have h := rational_next B (iter B 2) (1+X^2) X hb ht
  have hd : ((1 : PowerSeries F)+X^2)^2+X^2=1+X^2+X^4 := by
    linear_combination (X : PowerSeries F)^2 * two_eq_zero
  rw [hd] at h
  have hp : (X : PowerSeries F)*(1+X^2)=X+X^3 := by ring
  simpa only [hp] using h

/-- Exact characteristic-two denominator for the third iterate. -/
theorem third_denominator :
    (A : PowerSeries F)*(1+X^2+X^4+X^6+X^8)=X+X^7 := by
  have ht : (A : PowerSeries F)*(1+(iter B 2)^2)=iter B 2 := by
    change compose B (iter B 2)*(1+(iter B 2)^2)=iter B 2
    simpa only [square_one_sub] using
      compose_B_denominator (iter (B : PowerSeries F) 2)
        (iter_normalized B_normalized 2).constantCoeff
  have h := rational_next (iter (B : PowerSeries F) 2) A
    (1+X^2+X^4) (X+X^3) second_denominator ht
  have hd : ((1 : PowerSeries F)+X^2+X^4)^2+(X+X^3)^2 =
      1+X^2+X^4+X^6+X^8 := by
    linear_combination ((X : PowerSeries F)^2+2*X^4+X^6) * two_eq_zero
  have hp : ((X : PowerSeries F)+X^3)*(1+X^2+X^4) = X+X^7 := by
    linear_combination ((X : PowerSeries F)^3+X^5) * two_eq_zero
  simpa only [hd, hp] using h

/-- The complete rational identity underlying both OEIS conjectures. -/
theorem third_period_denominator :
    (A : PowerSeries F)*(1+X^10)=X+X^3+X^7+X^9 := by
  linear_combination
    (1+(X : PowerSeries F)^2)*third_denominator -
      A*(X^2+X^4+X^6+X^8)*two_eq_zero

/-- The four odd residue classes in one complete period. -/
def oddSupport (n : ℕ) : Prop := n%10=1 ∨ n%10=3 ∨ n%10=7 ∨ n%10=9

instance (n : ℕ) : Decidable (oddSupport n) := inferInstanceAs
  (Decidable (n%10=1 ∨ n%10=3 ∨ n%10=7 ∨ n%10=9))

private def periodic : PowerSeries F :=
  PowerSeries.mk (fun n => if oddSupport n then 1 else 0)

private theorem periodic_denominator :
    periodic*(1+X^10)=(X : PowerSeries F)+X^3+X^7+X^9 := by
  ext n
  rw [mul_add, mul_one]
  simp only [map_add, periodic, coeff_mk, coeff_mul_X_pow', coeff_X, coeff_X_pow]
  by_cases hn : n < 10
  · interval_cases n <;> norm_num [oddSupport]
  · have hm : (n-10)%10=n%10 := by omega
    have hsupport : oddSupport (n-10) ↔ oddSupport n := by simp [oddSupport, hm]
    simp only [if_pos (by omega : 10≤n), hsupport,
      if_neg (by omega : n≠1), if_neg (by omega : n≠3),
      if_neg (by omega : n≠7), if_neg (by omega : n≠9)]
    split_ifs <;> decide

theorem A_mod_two : (A : PowerSeries F)=periodic := by
  have hv : (1+(X : PowerSeries F)^10)*compose (geom (1 : F)) (X^10)=1 := by
    simpa only [map_one, one_mul, sub_eq_add_neg, neg_eq_self] using
      geom_compose_inverse (1 : F) (X^10) (by simp)
  have hu : IsUnit ((1 : PowerSeries F)+X^10) := by
    apply isUnit_iff_exists_inv.mpr
    exact ⟨compose (geom (1 : F)) (X^10), hv⟩
  exact hu.mul_right_cancel (third_period_denominator.trans periodic_denominator.symm)

/-- Complete coefficient formula modulo two, for every index. -/
theorem a396093_residue (n : ℕ) :
    (a n : ZMod 2)=if oddSupport n then 1 else 0 := by
  have h := congrArg (coeff F n) (map_A (Int.castRingHom F))
  simpa only [PowerSeries.coeff_map, Int.coe_castRingHom, a,
    A_mod_two, periodic, coeff_mk] using h

private theorem even_iff_cast_zero (z : ℤ) : Even z ↔ (z : ZMod 2)=0 := by
  rw [even_iff_two_dvd]
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd z 2).symm

theorem a396093_even_iff (n : ℕ) : Even (a n) ↔ ¬oddSupport n := by
  rw [even_iff_cast_zero, a396093_residue]
  by_cases hn : oddSupport n <;> simp [hn]

theorem a396093_odd_iff (n : ℕ) : Odd (a n) ↔ oddSupport n := by
  rw [← Int.not_even_iff_odd, a396093_even_iff]
  simp

/-- OEIS conjecture 1; the proof also covers index zero. -/
theorem a396093_even_indices (n : ℕ) : Even (a (2*n)) := by
  rw [a396093_even_iff]
  unfold oddSupport
  omega

/-- OEIS conjecture 2 in its equivalent residue-class form. -/
theorem a396093_odd_indices (n : ℕ) (hn : 1≤n) :
    Even (a (2*n-1)) ↔ n%5=3 := by
  rw [a396093_even_iff]
  unfold oddSupport
  omega

/-- OEIS conjecture 2 in the exact `5*k-2`, `k≥1` formulation. -/
theorem a396093_odd_indices_original (n : ℕ) (hn : 1≤n) :
    Even (a (2*n-1)) ↔ ∃ k : ℕ, 1≤k ∧ n=5*k-2 := by
  rw [a396093_odd_indices n hn]
  constructor
  · intro h
    refine ⟨n/5+1, by omega, ?_⟩
    have hd := Nat.mod_add_div n 5
    omega
  · rintro ⟨k, hk, rfl⟩
    omega

end
end RationalParity
