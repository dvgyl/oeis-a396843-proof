import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.Nat.Choose.Basic
import Mathlib.Tactic

/-!
# Stirling numbers and the power expansion

The pinned Mathlib revision predates its Stirling module.  We use the standard
recurrence here.  The proof of the power expansion follows the familiar
descending-factorial recurrence; see also the later Mathlib module
`Mathlib.Combinatorics.Enumerative.Stirling` (Beibei Xiong, Yu Shao, Weijie Jiang,
Zhengfeng Yang), commit 4ed598f443601d8b5abccc2a14e3ba408ae47056.

The standard recurrence and the power-expansion proof are adapted from that
upstream module. The compatibility lemma, truncated binomial form, and subsequent
periodicity development were generated by OpenAI ChatGPT for Dev D. Goyal. Every
declaration is checked by the Lean kernel when built.
-/

namespace More.Stirling

open Finset

/-- The Stirling numbers of the second kind, by their standard recurrence. -/
def second : ℕ → ℕ → ℕ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | _ + 1, 0 => 0
  | n + 1, k + 1 => (k + 1) * second n (k + 1) + second n k

@[simp] theorem second_zero_zero : second 0 0 = 1 := rfl
@[simp] theorem second_zero_succ (k : ℕ) : second 0 (k + 1) = 0 := rfl
@[simp] theorem second_succ_zero (n : ℕ) : second (n + 1) 0 = 0 := rfl

theorem second_step (n k : ℕ) :
    second (n + 1) (k + 1) = (k + 1) * second n (k + 1) + second n k := rfl

theorem second_zero_of_lt {n k : ℕ} (h : n < k) : second n k = 0 := by
  induction n generalizing k with
  | zero =>
      cases k with
      | zero => omega
      | succ k => rfl
  | succ n ih =>
      cases k with
      | zero => omega
      | succ k =>
          rw [second_step, ih (by omega), ih (by omega)]
          simp

theorem descFactorial_mul_self (a k : ℕ) :
    a.descFactorial k * a = a.descFactorial (k + 1) + k * a.descFactorial k := by
  by_cases h : k ≤ a
  · rw [Nat.descFactorial_succ]
    have he : a - k + k = a := Nat.sub_add_cancel h
    nlinarith
  · have hlt : a < k := by omega
    simp [Nat.descFactorial_of_lt hlt,
      Nat.descFactorial_of_lt (show a < k + 1 by omega)]

theorem power_expansion (a n : ℕ) :
    a ^ n = ∑ k ∈ range (n + 1), second n k * a.descFactorial k := by
  induction n with
  | zero => simp
  | succ n ih =>
      have shift :
          (∑ k ∈ range (n + 1), second n k * (k * a.descFactorial k)) =
          ∑ k ∈ range (n + 1),
            (k + 1) * (second n (k + 1) * a.descFactorial (k + 1)) := by
        rw [sum_range_succ' (fun k => second n k * (k * a.descFactorial k)) n,
          sum_range_succ (fun k =>
            (k + 1) * (second n (k + 1) * a.descFactorial (k + 1))) n]
        simp [second_zero_of_lt (Nat.lt_succ_self n), mul_left_comm]
      rw [pow_succ, ih, sum_mul,
        sum_range_succ' (fun k => second (n + 1) k * a.descFactorial k) (n + 1)]
      simp only [mul_assoc, descFactorial_mul_self, mul_add, sum_add_distrib,
        shift, second_step, add_mul, second_succ_zero, zero_mul, add_zero]
      exact add_comm _ _

/-- For `a ≤ n`, the power expansion can be truncated at `a`. -/
theorem power_expansion_choose (a n : ℕ) (h : a ≤ n) :
    a ^ n = ∑ k ∈ range (a + 1), a.choose k * (k.factorial * second n k) := by
  rw [power_expansion]
  have truncate :
      (∑ k ∈ range (n + 1), second n k * a.descFactorial k) =
      ∑ k ∈ range (a + 1), second n k * a.descFactorial k := by
    symm
    apply sum_subset (range_mono (show a + 1 ≤ n + 1 by omega))
    intro k hk hknot
    have hak : a < k := by
      simp only [mem_range] at hk hknot
      omega
    simp [Nat.descFactorial_of_lt hak]
  rw [truncate]
  apply sum_congr rfl
  intro k hk
  rw [Nat.descFactorial_eq_factorial_mul_choose]
  ac_rfl

end More.Stirling
